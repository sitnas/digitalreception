# ============================================================================
#  Registro visitatori - configurazione. NON committare il file .env reale.
#  Generare i segreti con:  docker compose run --rm api npm run keys
# ============================================================================
NODE_ENV=production

# --- Multi-tenancy -----------------------------------------------------------
# single    = installazione dedicata a una sola azienda (on-premise o cloud privato)
# subdomain = SaaS condiviso: ogni cliente su <slug>.<BASE_DOMAIN>
TENANCY_MODE=single
DEFAULT_TENANT_SLUG=azienda
# BASE_DOMAIN=reception.example.com

# --- Segreti (obbligatori) ---------------------------------------------------
# Chiavi master (KEK): proteggono le chiavi di ogni cliente. L'ultima della lista è quella attiva.
# Rotazione: aggiungere ",k2:<nuova>", riavviare, eseguire "npm run tenant -- rewrap-keys".
MASTER_KEYS=k1:CHANGE_ME_BASE64_32_BYTES
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# --- Database (MySQL 8 / MariaDB 10.11+) --------------------------------------
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=reception
DB_USER=reception
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10

# --- Archiviazione immagini cifrate ------------------------------------------
# local = volume del server (una replica, o più repliche su volume condiviso)
# s3    = qualsiasi storage compatibile S3 (MinIO on-premise o bucket cloud) per scalare
STORAGE_DRIVER=local
# S3_BUCKET=reception
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Email: informativa, badge di uscita, avviso alla persona da incontrare -----
# Vuoto = invio disattivato (il tablet non chiede l'email). Porta 587 con STARTTLS,
# oppure 465 con SMTP_SECURE=true. Esempio Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_USER=indirizzo gmail, SMTP_PASS=password per le app (non quella dell'account),
# MAIL_FROM=lo stesso indirizzo. Verifica: Console > Organizzazione > Invia email di prova.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=reception@example.com

# --- Sicurezza e rete ----------------------------------------------------------
SESSION_HOURS=8
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
COOKIE_SECURE=true
# Numero di proxy fidati davanti all'API (nginx del container web = 1; + load balancer = 2)
TRUST_PROXY=2
# Con N repliche i job girano comunque una volta sola (lock su DB). false = replica solo-API.
JOBS_ENABLED=true
HTTP_PORT=8080
