<?xml version="1.0" encoding="utf-8"?>
<!-- requireDeviceUnlock: a locked phone in a pocket never answers a reader. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/badge_nfc_service"
  android:requireDeviceUnlock="true">
  <aid-group android:category="other" android:description="@string/badge_nfc_service">
    <!-- NDEF Tag Application (NFC Forum Type 4 Tag) -->
    <aid-filter android:name="D2760000850101" />
  </aid-group>
</host-apdu-service>
